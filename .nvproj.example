-- Copy this file to your project root and rename to `.nvproj`
-- Remove or comment out sections you don't need

-- Example: C# / Unity project
return {
	env = {
		type = "csharp",   -- "csharp" | "cpp"
	},
	features = {
		debug = true,           -- nvim-dap + dap-ui + adapters
		format_on_save = true,  -- conform.nvim auto-format on save
	},
}

