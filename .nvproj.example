-- Copy this file to your project root and rename to `.nvproj`
-- Remove or comment out sections you don't need

-- Copy this file to your project root and rename to `.nvproj`
-- Features enabled by default (set to false to disable):
--   debug, format_on_save
--
-- Features must be explicitly enabled: csharp, unity, cpp, cmake, go, flutter, lua

-- Example: C# / Unity project
return {
	features = {
		-- Language features (auto-enable LSP + formatter + DAP + treesitter)
		csharp = true,       -- roslyn LSP, csharpier, netcoredbg
		-- unity = true,     -- implies csharp, uses nvim-dap-unity

		-- Feature toggles (optional — on by default)
		-- format_on_save = true,  -- conform.nvim auto-format on save
	},
	exclude = {
		files = { "*.meta" },                        -- hide in telescope
		dirs = { "Library", "Temp", "Build", "obj" }, -- hide in nvim-tree + telescope
	},
}

