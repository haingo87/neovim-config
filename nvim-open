#!/usr/bin/env python3
"""
nvim-open <file> — open a file in the correct running Neovim instance.

Routes by prefix-matching the file's path against registered project roots
in ~/.local/state/nvim/sessions.json. Unmatched files go to the orphan instance.
"""
import argparse
import json
import os
import shutil
import subprocess
import sys
import time

SESSIONS_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "nvim",
)
SESSIONS_PATH = os.path.join(SESSIONS_DIR, "sessions.json")
LOCK_FILE = os.path.join(SESSIONS_DIR, "sessions.lock")
SOCKETS_DIR = os.path.join(SESSIONS_DIR, "sockets")
ORPHAN_SOCKET = os.path.join(SOCKETS_DIR, "nv-orphan.sock")


def _acquire_lock():
    """PID-based exclusive-create lock. Matches session.lua mechanism.

    Writes our PID into the lock file. If lock exists and holder is dead (stale),
    removes it and retries. Crash-safe: dead lock detected via kill(pid, 0)
    and ps-based nvim verification.

    Caller must call _release_lock() after the critical section.
    """
    os.makedirs(SESSIONS_DIR, exist_ok=True)
    pid = os.getpid()
    for _ in range(40):
        try:
            fd = os.open(LOCK_FILE, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            os.write(fd, str(pid).encode())
            os.close(fd)
            return
        except FileExistsError:
            try:
                with open(LOCK_FILE) as f:
                    holder_pid = int(f.read().strip())
                os.kill(holder_pid, 0)
                comm = subprocess.run(
                    ["ps", "-p", str(holder_pid), "-o", "comm="],
                    capture_output=True, text=True, timeout=2,
                ).stdout.strip()
                if "nvim" not in comm:
                    raise ProcessLookupError
            except (ProcessLookupError, FileNotFoundError, ValueError):
                try:
                    os.unlink(LOCK_FILE)
                except OSError:
                    pass
                continue
            time.sleep(0.05)
    raise RuntimeError("Could not acquire session lock after 2s")


def _release_lock():
    try:
        os.unlink(LOCK_FILE)
    except OSError:
        pass


def _read_sessions():
    try:
        with open(SESSIONS_PATH, "r") as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return []


def _write_sessions(sessions):
    tmp = SESSIONS_PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(sessions, f)
    os.replace(tmp, SESSIONS_PATH)


def _nvim_env():
    """Return env dict with $NVIM cleared. When running inside a Neovim
    terminal, $NVIM points to the parent server, causing --remote/--remote-expr
    to hang connecting to the wrong address."""
    env = os.environ.copy()
    env.pop("NVIM", None)
    return env


def _health_check(sessions):
    """Prune dead entries. 1s timeout to allow for slower startup contexts."""
    alive = []
    env = _nvim_env()
    for s in sessions:
        try:
            result = subprocess.run(
                ["nvim", "--server", s["socket"], "--remote-expr", "1"],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                stdin=subprocess.DEVNULL, timeout=1, env=env,
            )
            if result.returncode == 0:
                alive.append(s)
        except (subprocess.TimeoutExpired, FileNotFoundError):
            pass
    return alive


def _nvim_remote(socket, filepath):
    if not os.path.exists(socket):
        return False
    try:
        result = subprocess.run(
            ["nvim", "--server", socket, "--remote", filepath],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            stdin=subprocess.DEVNULL, timeout=5, env=_nvim_env(),
        )
        return result.returncode == 0
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return False


def _launch_project(dirpath):
    """Launch a new Neovim instance for the given project directory.
    Uses cwd= so vim.fn.getcwd() in init.lua returns the project root.
    No --listen needed — init.lua calls serverstart() on the deterministic socket.
    No NVIM_ORPHAN_GROUP — this is a normal project instance."""
    if sys.stdin.isatty():
        subprocess.run(["nvim"], cwd=dirpath, env=_nvim_env())
    else:
        subprocess.Popen(["nvim"], cwd=dirpath, env=_nvim_env(), start_new_session=True)


def _launch_orphan(filepath):
    """Launch orphan Neovim with --listen so the socket exists immediately.

    When called from a terminal, run in foreground so keyboard input works.
    When called from Finder/Unity (no TTY), detach via start_new_session.
    """
    os.makedirs(SOCKETS_DIR, exist_ok=True)
    env = _nvim_env()
    env["NVIM_ORPHAN_GROUP"] = "1"
    cmd = ["nvim", "--listen", ORPHAN_SOCKET, filepath]

    if sys.stdin.isatty():
        subprocess.run(cmd, env=env)
    else:
        subprocess.Popen(cmd, env=env, start_new_session=True)


def main():
    if not shutil.which("nvim"):
        sys.exit("nvim-open: nvim not found in PATH. Is Neovim installed?")

    parser = argparse.ArgumentParser(description="Open file in correct Neovim instance")
    parser.add_argument("file", nargs="?", help="File path to open")
    parser.add_argument("--list", action="store_true", help="List registered sessions")
    args = parser.parse_args()

    if args.list:
        sessions = _read_sessions()
        if not sessions:
            print("No registered sessions.")
            sys.exit(0)
        env = _nvim_env()
        for s in sessions:
            alive = ""
            try:
                result = subprocess.run(
                    ["nvim", "--server", s["socket"], "--remote-expr", "1"],
                    stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                    stdin=subprocess.DEVNULL, timeout=1, env=env,
                )
                if result.returncode == 0:
                    alive = " [alive]"
                else:
                    alive = f" [DEAD] rc={result.returncode} stderr={result.stderr.decode().strip()}"
            except subprocess.TimeoutExpired:
                alive = " [DEAD] (timeout)"
            except FileNotFoundError:
                alive = " [DEAD] (nvim not found)"
            print(f"{s['project_root']} -> {s['socket']}{alive}")
        sys.exit(0)

    if not args.file:
        sys.exit("nvim-open: file argument required (use --list to view sessions)")

    # Determine if it's a directory (check before realpath — fails for non-existent paths)
    is_dir = os.path.isdir(args.file)

    filepath = args.file
    try:
        filepath = os.path.realpath(args.file)
    except FileNotFoundError:
        if is_dir:
            filepath = os.path.abspath(args.file)
        else:
            dirpart = os.path.realpath(os.path.dirname(args.file))
            filepath = os.path.join(dirpart, os.path.basename(args.file))

    # Read sessions under lock, health-check, write back pruned list
    os.makedirs(SESSIONS_DIR, exist_ok=True)
    _acquire_lock()
    try:
        sessions = _read_sessions()
        sessions = _health_check(sessions)
        _write_sessions(sessions)
    finally:
        _release_lock()

    # Directory → launch project instance (or route to existing one)
    if is_dir or os.path.isdir(filepath):
        for s in sessions:
            if filepath == s["project_root"]:
                if _nvim_remote(s["socket"], filepath):
                    return
                break
        _launch_project(filepath)
        return

    for s in sessions:
        if filepath.startswith(s["project_root"] + os.sep):
            if _nvim_remote(s["socket"], filepath):
                return
            break

    for attempt in range(3):
        if _nvim_remote(ORPHAN_SOCKET, filepath):
            return
        time.sleep(0.1)

    _launch_orphan(filepath)


if __name__ == "__main__":
    main()
