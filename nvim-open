#!/usr/bin/env python3
"""
nvim-open [path] [-g file:line:col] — open a file in the correct running Neovim instance.

Routes by prefix-matching the file's path against registered project roots
via the nvim-daemon. Supports VSCode-style arguments (project_dir -g file:line).
"""
import argparse
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import time

SOCKET_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "nvim",
)
DAEMON_SOCKET = os.path.join(SOCKET_DIR, "daemon.sock")
SOCKETS_DIR = os.path.join(SOCKET_DIR, "sockets")
ORPHAN_SOCKET = os.path.join(SOCKETS_DIR, "nv-orphan.sock")
DAEMON_SCRIPT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "nvim-daemon")
TIMEOUT = 5

# Terminals that can open a new tab running a command.
# Each entry: prefix args + nvim args are appended.
# "shell": True means -e expects a single shell-quoted string.
_TAB_TERMINALS = {
    "xfce4-terminal":   { "pre": ["--tab", "-x"],          "wd": "--working-directory" },
    "gnome-terminal":   { "pre": ["--tab", "--"],          "wd": "--working-directory" },
    "mate-terminal":    { "pre": ["--tab", "-x"],          "wd": "--working-directory" },
    "konsole":          { "pre": ["--new-tab", "-e"],      "wd": "--working-directory" },
    "terminator":       { "pre": ["--new-tab", "-x"],      "wd": "--working-directory" },
    "tilix":            { "pre": ["--action=app-new-session", "-e"], "wd": "--working-directory", "shell": True },
}

# Terminals with no tab support — open a new window.
_NEW_WINDOW_TERMINALS = {
    "xterm":     { "pre": ["-e"] },
    "uxterm":    { "pre": ["-e"] },
    "alacritty": { "pre": ["-e"] },
    "st":        { "pre": ["-e"] },
}


def _wezterm_tab_cmd(cmd_args, cwd=None):
    base = ["wezterm", "cli", "spawn"]
    if cwd:
        base += ["--cwd", cwd]
    return base + ["--"] + cmd_args


def _kitty_tab_cmd(cmd_args, cwd=None):
    base = ["kitty", "@", "new-window", "--new-tab"]
    if cwd:
        base += ["--cwd", cwd]
    return base + ["--"] + cmd_args


_SPECIAL_TERMINALS = {
    "wezterm": _wezterm_tab_cmd,
    "kitty":   _kitty_tab_cmd,
}


def _detect_terminal():
    """Detect the terminal emulator to create tabs in.

    Tries multiple methods in order:
    1. X11 active window WM_CLASS (most reliable on X11)
    2. Walk parent PID chain from current process
    3. $TERMINAL environment variable
    Returns the terminal binary name (lowercase), or None.
    """
    known = set(_TAB_TERMINALS) | set(_NEW_WINDOW_TERMINALS) | set(_SPECIAL_TERMINALS)

    if shutil.which("xdotool") and shutil.which("xprop"):
        try:
            wid = subprocess.run(
                ["xdotool", "getactivewindow"],
                capture_output=True, text=True, timeout=2,
            ).stdout.strip()
            if wid:
                wm = subprocess.run(
                    ["xprop", "-id", wid, "WM_CLASS"],
                    capture_output=True, text=True, timeout=2,
                ).stdout
                m = re.findall(r'"([^"]+)"', wm)
                if len(m) >= 2:
                    return m[1].lower()
        except (FileNotFoundError, subprocess.TimeoutExpired, ValueError):
            pass

    try:
        pid = os.getpid()
        for _ in range(10):
            comm = subprocess.run(
                ["ps", "-p", str(pid), "-o", "comm="],
                capture_output=True, text=True, timeout=2,
            ).stdout.strip().lower()
            if comm in known:
                return comm
            ppid = subprocess.run(
                ["ps", "-p", str(pid), "-o", "ppid="],
                capture_output=True, text=True, timeout=2,
            ).stdout.strip()
            pid = int(ppid) if ppid else 1
            if pid <= 1:
                break
    except (FileNotFoundError, subprocess.TimeoutExpired, ValueError):
        pass

    term = os.environ.get("TERMINAL", "").lower()
    if term:
        return term

    return None


# --- macOS terminal support ---

def _escape_applescript(s):
    return s.replace("\\", "\\\\").replace('"', '\\"')


def _detect_macos_terminal():
    """Detect the user's terminal on macOS.

    Checks TERMINAL env var first (user preference),
    then queries running apps, then falls back to Terminal.app.
    """
    term = os.environ.get("TERMINAL", "").lower()
    if term in ("ghostty", "iterm2", "terminal"):
        return term

    try:
        r = subprocess.run(
            ["osascript", "-e",
             'tell application "System Events" to get name of every process'],
            capture_output=True, text=True, timeout=3,
        )
        running = {n.strip().lower() for n in r.stdout.split(",")}
        if "ghostty" in running:
            return "ghostty"
        if "iterm2" in running:
            return "iterm2"
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        pass

    if shutil.which("ghostty"):
        return "ghostty"

    return "terminal"


def _ghostty_macos(cmd_args, cwd=None, verbose=False):
    env = os.environ.copy()
    env.pop("NVIM", None)
    env_path = env.get("PATH", "")

    shell_cmd = "env PATH=" + shlex.quote(env_path) + " " + shlex.join(cmd_args)
    esc_cmd = _escape_applescript(shell_cmd)

    script = (
        'tell application "Ghostty"\n'
        '    set cfg to new surface configuration\n'
        f'    set command of cfg to "{esc_cmd}"\n'
    )
    if cwd:
        script += f'    set initial working directory of cfg to "{_escape_applescript(cwd)}"\n'
    script += (
        '    try\n'
        '        new tab in front window with configuration cfg\n'
        '    on error\n'
        '        new window with configuration cfg\n'
        '    end try\n'
        '    activate\n'
        'end tell'
    )

    if verbose:
        print(f"Running: osascript Ghostty → {shell_cmd}", file=sys.stderr)
    subprocess.Popen(["osascript", "-e", script], env=env, start_new_session=True)


def _iterm2_macos(cmd_args, cwd=None, verbose=False):
    env = os.environ.copy()
    env.pop("NVIM", None)
    env_path = env.get("PATH", "")

    shell_cmd = "env PATH=" + shlex.quote(env_path) + " " + shlex.join(cmd_args)
    esc_cmd = _escape_applescript(shell_cmd)

    script = (
        'tell application "iTerm2"\n'
        '    activate\n'
        f'    tell current window\n'
        f'        create tab with default profile command "{esc_cmd}"\n'
        '    end tell\n'
        'end tell'
    )

    if verbose:
        print(f"Running: osascript iTerm2 → {shell_cmd}", file=sys.stderr)
    subprocess.Popen(["osascript", "-e", script], env=env, start_new_session=True)


def _terminal_app_macos(cmd_args, cwd=None, verbose=False):
    env = os.environ.copy()
    env.pop("NVIM", None)
    env_path = env.get("PATH", "")

    shell_cmd = "env PATH=" + shlex.quote(env_path) + " " + shlex.join(cmd_args)
    esc_cmd = _escape_applescript(shell_cmd)

    script = (
        'tell application "Terminal"\n'
        '    activate\n'
        '    try\n'
        f'        do script "{esc_cmd}" in front window\n'
        '    on error\n'
        f'        do script "{esc_cmd}"\n'
        '    end try\n'
        'end tell'
    )

    if verbose:
        print(f"Running: osascript Terminal → {shell_cmd}", file=sys.stderr)
    subprocess.Popen(["osascript", "-e", script], env=env, start_new_session=True)


def _spawn_macos_terminal(cmd_args, cwd=None, verbose=False):
    terminal = _detect_macos_terminal()
    if terminal == "ghostty":
        _ghostty_macos(cmd_args, cwd, verbose)
    elif terminal == "iterm2":
        _iterm2_macos(cmd_args, cwd, verbose)
    else:
        _terminal_app_macos(cmd_args, cwd, verbose)


# --- Linux terminal support ---

def _spawn_terminal_tab(cmd_args, cwd=None, verbose=False):
    """Spawn a command in a new terminal tab (or window if tabs unsupported).

    Detects the running terminal and uses its native tab-creation method.
    Falls back to xterm -e if unknown terminal or detection fails.
    """
    if sys.platform == "darwin":
        _spawn_macos_terminal(cmd_args, cwd, verbose)
        return

    terminal = _detect_terminal()
    if verbose:
        name = terminal or "xterm (fallback)"
        print(f"Terminal: {name}", file=sys.stderr)

    env = os.environ.copy()
    env.pop("NVIM", None)

    if terminal in _SPECIAL_TERMINALS:
        full_cmd = _SPECIAL_TERMINALS[terminal](cmd_args, cwd)
        if verbose:
            print(f"Running: {shlex.join(full_cmd)}", file=sys.stderr)
        subprocess.Popen(full_cmd, env=env, start_new_session=True)
        return

    if terminal in _TAB_TERMINALS:
        info = _TAB_TERMINALS[terminal]
        base_cmd = [terminal] + list(info["pre"])
        if cwd and info["wd"]:
            base_cmd += [info["wd"], cwd]
        cmd_part = [shlex.join(cmd_args)] if info.get("shell") else cmd_args
        full_cmd = base_cmd + cmd_part
        if verbose:
            print(f"Running: {shlex.join(full_cmd)}", file=sys.stderr)
        subprocess.Popen(full_cmd, env=env, start_new_session=True)
        return

    if terminal in _NEW_WINDOW_TERMINALS:
        info = _NEW_WINDOW_TERMINALS[terminal]
        full_cmd = [terminal] + list(info["pre"]) + cmd_args
        if verbose:
            print(f"Running: {shlex.join(full_cmd)}", file=sys.stderr)
        subprocess.Popen(full_cmd, env=env, start_new_session=True)
        return

    if shutil.which("xfce4-terminal"):
        full_cmd = ["xfce4-terminal", "--tab", "-x"] + cmd_args
    else:
        full_cmd = ["xterm", "-e"] + cmd_args
    if verbose:
        print(f"Running: {shlex.join(full_cmd)}", file=sys.stderr)
    subprocess.Popen(full_cmd, env=env, start_new_session=True)


def _connect_daemon(verbose=False):
    """Connect to the daemon socket. Start daemon if not running."""
    for attempt in range(3):
        if not os.path.exists(DAEMON_SOCKET):
            _start_daemon(verbose)
            continue
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.settimeout(TIMEOUT)
            sock.connect(DAEMON_SOCKET)
            return sock
        except (ConnectionRefusedError, OSError):
            if os.path.exists(DAEMON_SOCKET):
                os.unlink(DAEMON_SOCKET)
            _start_daemon(verbose)
            continue
    return None


def _start_daemon(verbose=False):
    """Start the daemon process."""
    env = os.environ.copy()
    env.pop("NVIM", None)
    subprocess.Popen(
        [sys.executable, DAEMON_SCRIPT, "--foreground"],
        env=env,
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    for _ in range(50):
        if os.path.exists(DAEMON_SOCKET):
            return
        time.sleep(0.1)


def _send_recv(sock, msg, verbose=False):
    """Send a JSON message and receive the response.

    Only the first JSON line is parsed; any additional lines are discarded.
    This is safe for this protocol where each request yields exactly one response."""
    data = json.dumps(msg) + "\n"
    if verbose:
        print(f"-> {data.strip()}", file=sys.stderr)
    sock.sendall(data.encode())

    buf = b""
    while b"\n" not in buf:
        chunk = sock.recv(4096)
        if not chunk:
            raise ConnectionError("Daemon closed connection")
        buf += chunk

    line = buf.split(b"\n")[0]
    resp = json.loads(line)
    if verbose:
        print(f"<- {json.dumps(resp)}", file=sys.stderr)
    return resp


def _nvim_env():
    env = os.environ.copy()
    env.pop("NVIM", None)
    return env


def _nvim_remote(socket_path, filepath, line=None, col=None, verbose=False):
    """Fire-and-forget: open a file in a running Neovim instance.

    All nvim --remote commands are spawned in the background so the
    Python process exits immediately and doesn't linger in the TTY.
    """
    if not os.path.exists(socket_path):
        return False
    env = _nvim_env()

    def _bg(args):
        subprocess.Popen(
            args,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL, env=env,
        )

    _bg(["nvim", "--server", socket_path, "--remote", filepath])
    _bg(["nvim", "--server", socket_path, "--remote-expr", "checktime()"])

    if line:
        col_val = col or 1
        _bg(["nvim", "--server", socket_path, "--remote-expr",
             f"cursor({line},{col_val})"])

    _bg(["nvim", "--server", socket_path, "--remote-expr",
         "v:lua.require('util.redirect').bring_to_front()"])

    # Best-effort window activation in a detached subprocess
    _activate_window(socket_path, filepath, env)

    if verbose:
        print(f"Sent {filepath} to {socket_path}", file=sys.stderr)
    return True


def _activate_window(socket_path, filepath, env):
    """Detached script that reads focus info and activates the window."""
    code = (
        "import subprocess, json, os, shutil, sys\n"
        "try:\n"
        "  r = subprocess.run(\n"
        f"    ['nvim', '--server', {json.dumps(socket_path)},\n"
        "     '--remote-expr', "
        "'v:lua.require(\"util.redirect\").focus_info()'],\n"
        "    capture_output=True, text=True, timeout=5, env=os.environ)\n"
        "  if r.returncode != 0 or not r.stdout.strip(): sys.exit(0)\n"
        "  info = r.stdout.strip()\n"
        "  wid, _ = info.split(':', 1) if ':' in info else (info, None)\n"
        "  if not shutil.which('xdotool'): sys.exit(0)\n"
        "  subprocess.run(['xdotool', 'windowactivate', wid],\n"
        "    capture_output=True, timeout=5)\n"
        "except Exception:\n"
        "  pass\n"
    )
    subprocess.Popen(
        [sys.executable, "-c", code],
        stdin=subprocess.DEVNULL,
        env=env,
        start_new_session=True,
    )


def _find_atspi_tab_list(root):
    """Recursively find the first ROLE_PAGE_TAB_LIST child in the AT-SPI tree."""
    import pyatspi
    try:
        if root.getRole() == pyatspi.ROLE_PAGE_TAB_LIST:
            return root
    except Exception:
        pass
    for i in range(root.childCount):
        try:
            result = _find_atspi_tab_list(root[i])
            if result is not None:
                return result
        except Exception:
            pass
    return None


def _find_nvim_tab_atspi(project_dirname=None, filepath=None):
    """Find nvim's tab index via AT-SPI2 tab name matching.

    Returns 0-based tab index, or -1 if not found / pyatspi unavailable.
    """
    try:
        import pyatspi
    except ImportError:
        return -1

    try:
        desktop = pyatspi.Registry.getDesktop(0)
        xfce_app = next((a for a in desktop if a.name == "xfce4-terminal"), None)
        if xfce_app is None:
            return -1

        for win in xfce_app:
            if win.getRoleName() != "frame":
                continue
            tab_list = _find_atspi_tab_list(win)
            if tab_list is None:
                continue

            for ti in range(tab_list.childCount):
                tab = tab_list[ti]
                if project_dirname:
                    candidates = [
                        tab.name.startswith(project_dirname + " - "),
                        tab.name.startswith(project_dirname + " | "),
                        tab.name == project_dirname,
                    ]
                    match = any(candidates)
                elif filepath:
                    fname = os.path.basename(filepath)
                    match = tab.name == fname
                else:
                    match = False

                if match:
                    return ti

        return -1

    except Exception:
        return -1


def _focus_orphan(socket_path, verbose=False):
    """Bring the orphan Neovim instance to front without opening a file."""
    if not os.path.exists(socket_path):
        return False
    env = _nvim_env()
    subprocess.Popen(
        ["nvim", "--server", socket_path, "--remote-expr",
         "v:lua.require('util.redirect').bring_to_front()"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        stdin=subprocess.DEVNULL, env=env,
    )
    return True


def _launch_orphan(filepath, verbose=False):
    os.makedirs(SOCKETS_DIR, exist_ok=True)
    if os.path.exists(ORPHAN_SOCKET):
        os.remove(ORPHAN_SOCKET)
    env = _nvim_env()
    env["NVIM_ORPHAN_GROUP"] = "1"
    cmd = [
        "nvim", "--listen", ORPHAN_SOCKET,
        "--cmd", "lua vim.g.neovim_orphan_group=true",
    ]
    if filepath:
        cmd.append(filepath)
    if verbose:
        print(f"Launching orphan with {filepath or 'no file'}", file=sys.stderr)
    if sys.stdin.isatty():
        os.execvpe(cmd[0], cmd, env)
    else:
        _spawn_terminal_tab(cmd, verbose=verbose)


def _launch_project(dirpath, verbose=False):
	if verbose:
		print(f"Launching project instance in {dirpath}", file=sys.stderr)
	if sys.stdin.isatty():
		env = _nvim_env()
		os.execvpe("nvim", ["nvim", dirpath], env)
	else:
		_spawn_terminal_tab(["nvim", dirpath], cwd=dirpath, verbose=verbose)


def _launch_project_with_file(dirpath, filepath, line, col, verbose=False):
	"""Launch a project instance and open a file at the given cursor position."""
	if verbose:
		print(f"Opening {filepath} in project {dirpath}", file=sys.stderr)

	if sys.stdin.isatty():
		# TTY: open NvimTree via Lua, then edit file and position cursor
		escaped = filepath.replace("\\", "\\\\").replace('"', '\\"')
		pos_cmd = (
			f"call cursor({line or 1}, {col})"
			if col else str(line or 1)
		)
		lua_cmd = (
			"lua "
			"local ok, tree = pcall(require, 'nvim-tree'); "
			"if ok then tree.open() end; "
			f"vim.cmd('silent! e {escaped}'); "
			f"vim.cmd('{pos_cmd} | wincmd w | wincmd w')"
		)
		cmd = ["nvim", dirpath, "-c", lua_cmd]
		if verbose:
			print(f"Launching: {' '.join(cmd)}", file=sys.stderr)
		env = _nvim_env()
		os.execvpe(cmd[0], cmd, env)
	else:
		# Non-TTY: launch project, poll daemon for registration, send file via --remote
		try:
			_spawn_terminal_tab(["nvim", dirpath], cwd=dirpath, verbose=verbose)
		except Exception as e:
			if verbose:
				print(f"Failed to launch terminal: {e}", file=sys.stderr)
			return

		for attempt in range(20):
			time.sleep(0.5)
			sock = _connect_daemon(verbose)
			if not sock:
				continue
			try:
				resp = _send_recv(sock, {"cmd": "list"}, verbose)
				for inst in resp.get("instances", []):
					if inst.get("project_root") == dirpath:
						_nvim_remote(inst["socket"], filepath, line, col, verbose)
						return
			except (ConnectionError, json.JSONDecodeError, OSError):
				pass
			finally:
				try:
					sock.close()
				except OSError:
					pass

		if verbose:
			print(f"Project instance did not appear within 10s, falling back to orphan", file=sys.stderr)
		_launch_orphan(filepath, verbose)


def _parse_path_with_line(filepath):
    """Parse file:line:col notation. Only splits on : after the last path separator."""
    base = filepath
    line = None
    col = None

    sep_pos = filepath.rfind(os.sep)
    colon_after_sep = filepath.find(":", sep_pos + 1) if sep_pos >= 0 else filepath.find(":")

    if colon_after_sep >= 0:
        remainder = filepath[colon_after_sep + 1:]
        base = filepath[:colon_after_sep]
        parts = remainder.split(":", 1)
        try:
            line = int(parts[0])
            if len(parts) > 1:
                col = int(parts[1])
        except ValueError:
            base = filepath
            line = None
            col = None

    return base, line, col


def main():
	if not shutil.which("nvim"):
		sys.exit("nvim-open: nvim not found in PATH. Is Neovim installed?")

	parser = argparse.ArgumentParser(description="Open file in correct Neovim instance")
	parser.add_argument("path", nargs="?", help="Project directory or file to open (supports file:line:col)")
	parser.add_argument("-g", "--goto", help="Open file at line:col (e.g., file.cs:10:5)")
	parser.add_argument("--line", type=int, default=None, help="Line number")
	parser.add_argument("--col", type=int, default=None, help="Column number")
	parser.add_argument("--list", action="store_true", help="List registered instances")
	parser.add_argument("--verbose", action="store_true", help="Enable debug logging to stderr")
	args = parser.parse_args()

	if args.list:
		sock = _connect_daemon(args.verbose)
		if not sock:
			print("No daemon running and could not start one.")
			sys.exit(1)
		resp = _send_recv(sock, {"cmd": "list"}, args.verbose)
		sock.close()
		instances = resp.get("instances", [])
		if not instances:
			print("No registered instances.")
		else:
			for inst in instances:
				alive = ""
				try:
					os.kill(inst["pid"], 0)
					alive = " [alive]"
				except ProcessLookupError:
					alive = " [DEAD]"
				except PermissionError:
					alive = " [alive]"
				label = "(orphan)" if inst.get("orphan") else inst["project_root"]
				print(f"{label} -> {inst['socket']}{alive}")
		sys.exit(0)

	# Resolve project directory and target file
	project_dir = None
	target_file = None
	line = args.line
	col = args.col

	# Parse -g goto file:line:col
	if args.goto:
		target_file, parsed_line, parsed_col = _parse_path_with_line(args.goto)
		if line is None: line = parsed_line
		if col is None: col = parsed_col

	# Resolve path (project dir or file)
	if args.path:
		resolved = os.path.realpath(args.path) if os.path.exists(args.path) else args.path
		if os.path.isdir(resolved):
			project_dir = resolved
		elif not target_file:
			# path is a file (not a dir) and no -g was given
			target_file, parsed_line, parsed_col = _parse_path_with_line(args.path)
			if line is None: line = parsed_line
			if col is None: col = parsed_col

	# Resolve target file relative to project directory
	if target_file and project_dir and not os.path.isabs(target_file):
		target_file = os.path.join(project_dir, target_file)

	# No file and no project — redirect to orphan or launch new one
	if not target_file and not project_dir:
		sock = _connect_daemon(args.verbose)
		if sock:
			resp = _send_recv(sock, {"cmd": "list"}, args.verbose)
			sock.close()
			for inst in resp.get("instances", []):
				if inst.get("orphan"):
					_focus_orphan(inst["socket"], args.verbose)
					sys.exit(0)
		_launch_orphan(None, args.verbose)
		sys.exit(0)

	# Project directory without file — launch or focus project
	if project_dir and not target_file:
		sock = _connect_daemon(args.verbose)
		if sock:
			resp = _send_recv(sock, {"cmd": "open", "path": project_dir}, args.verbose)
			sock.close()
			if resp["status"] == "routed":
				sys.exit(0)
		_launch_project(project_dir, args.verbose)
		sys.exit(0)

	# We have a file to open — resolve and route
	filepath = target_file
	try:
		filepath = os.path.realpath(filepath)
	except FileNotFoundError:
		dirpart = os.path.realpath(os.path.dirname(target_file))
		filepath = os.path.join(dirpart, os.path.basename(target_file))

	is_dir = os.path.isdir(filepath)
	if is_dir:
		sock = _connect_daemon(args.verbose)
		if sock:
			resp = _send_recv(sock, {"cmd": "open", "path": filepath}, args.verbose)
			sock.close()
			if resp["status"] == "routed":
				sys.exit(0)
		_launch_project(filepath, args.verbose)
		sys.exit(0)

	sock = _connect_daemon(args.verbose)
	if not sock:
		sys.exit("nvim-open: could not connect to daemon")

	resp = _send_recv(sock, {
		"cmd": "open",
		"path": filepath,
		"line": line,
		"col": col,
	}, args.verbose)
	sock.close()

	if resp["status"] == "routed":
		target_socket = resp["socket"]
		if not _nvim_remote(target_socket, filepath, line, col, args.verbose):
			if args.verbose:
				print(f"Warning: could not send {filepath} to {target_socket}, file may not exist", file=sys.stderr)
	elif resp["status"] == "no_instance":
		if project_dir:
			_launch_project_with_file(project_dir, filepath, line, col, args.verbose)
		else:
			_launch_orphan(filepath, args.verbose)


if __name__ == "__main__":
    main()
