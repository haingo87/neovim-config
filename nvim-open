#!/usr/bin/env python3
"""
nvim-open <file> — open a file in the correct running Neovim instance.

Routes by prefix-matching the file's path against registered project roots
via the nvim-daemon. Unmatched files go to the orphan instance.
"""
import argparse
import json
import os
import socket
import shutil
import subprocess
import sys
import time

SOCKET_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "nvim",
)
DAEMON_SOCKET = os.path.join(SOCKET_DIR, "daemon.sock")
SOCKETS_DIR = os.path.join(SOCKET_DIR, "sockets")
ORPHAN_SOCKET = os.path.join(SOCKETS_DIR, "nv-orphan.sock")
DAEMON_SCRIPT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "nvim-daemon")
TIMEOUT = 5


def _connect_daemon(verbose=False):
    """Connect to the daemon socket. Start daemon if not running."""
    for attempt in range(3):
        if not os.path.exists(DAEMON_SOCKET):
            _start_daemon(verbose)
            continue
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.settimeout(TIMEOUT)
            sock.connect(DAEMON_SOCKET)
            return sock
        except (ConnectionRefusedError, OSError):
            if os.path.exists(DAEMON_SOCKET):
                os.unlink(DAEMON_SOCKET)
            _start_daemon(verbose)
            continue
    return None


def _start_daemon(verbose=False):
    """Start the daemon process."""
    env = os.environ.copy()
    env.pop("NVIM", None)
    subprocess.Popen(
        [sys.executable, DAEMON_SCRIPT, "--foreground"],
        env=env,
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    for _ in range(50):
        if os.path.exists(DAEMON_SOCKET):
            return
        time.sleep(0.1)


def _send_recv(sock, msg, verbose=False):
    """Send a JSON message and receive the response.

    Only the first JSON line is parsed; any additional lines are discarded.
    This is safe for this protocol where each request yields exactly one response."""
    data = json.dumps(msg) + "\n"
    if verbose:
        print(f"-> {data.strip()}", file=sys.stderr)
    sock.sendall(data.encode())

    buf = b""
    while b"\n" not in buf:
        chunk = sock.recv(4096)
        if not chunk:
            raise ConnectionError("Daemon closed connection")
        buf += chunk

    line = buf.split(b"\n")[0]
    resp = json.loads(line)
    if verbose:
        print(f"<- {json.dumps(resp)}", file=sys.stderr)
    return resp


def _nvim_env():
    env = os.environ.copy()
    env.pop("NVIM", None)
    return env


def _nvim_remote(socket_path, filepath, line=None, col=None, verbose=False):
    """Open a file in a running Neovim instance, optionally positioning cursor.

    Uses --remote for file open (no string interpolation, safe from injection).
    Uses --remote-expr only for cursor positioning (no filepath in expression).
    """
    if not os.path.exists(socket_path):
        return False
    env = _nvim_env()
    exists = os.path.exists(filepath)
    try:
        result = subprocess.run(
            ["nvim", "--server", socket_path, "--remote", filepath],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            stdin=subprocess.DEVNULL, timeout=5, env=env,
        )
        if result.returncode != 0:
            return False
        if not exists:
            subprocess.run(
                ["nvim", "--server", socket_path, "--remote-expr",
                 f'vim.notify("File not found: {filepath}", vim.log.levels.WARN)'],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                stdin=subprocess.DEVNULL, timeout=5, env=env,
            )
        subprocess.run(
            ["nvim", "--server", socket_path, "--remote-expr", "checktime()"],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            stdin=subprocess.DEVNULL, timeout=5, env=env,
        )
        if line:
            col_val = col or 1
            subprocess.run(
                ["nvim", "--server", socket_path, "--remote-expr",
                 f"cursor({line},{col_val})"],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                stdin=subprocess.DEVNULL, timeout=5, env=env,
            )
        subprocess.run(
            ["nvim", "--server", socket_path, "--remote-expr",
             "v:lua.require('util.redirect').bring_to_front()"],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            stdin=subprocess.DEVNULL, timeout=5, env=env,
        )
        if verbose:
            print(f"Sent {filepath} to {socket_path}", file=sys.stderr)

        # Activate window and switch tab
        try:
            result = subprocess.run(
                ["nvim", "--server", socket_path, "--remote-expr",
                 "v:lua.require('util.redirect').focus_info()"],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                stdin=subprocess.DEVNULL, timeout=5, env=env,
            )
            if result.returncode == 0:
                info = result.stdout.decode().strip()
                if info and shutil.which("xdotool"):
                    if ":" in info:
                        wid, project_dirname = info.split(":", 1)
                    else:
                        wid = info
                        project_dirname = None

                    subprocess.run(
                        ["xdotool", "windowactivate", wid],
                        timeout=5, capture_output=True, text=True,
                    )
                    time.sleep(0.15)
                    tab_idx = _find_nvim_tab_atspi(
                        project_dirname=project_dirname, filepath=filepath,
                    )
                    if tab_idx >= 0:
                        key = f"alt+{tab_idx + 1}" if tab_idx < 9 else "alt+0"
                        subprocess.run(
                            ["xdotool", "key", key],
                            timeout=5, capture_output=True, text=True,
                        )
                    time.sleep(0.3)
        except (subprocess.TimeoutExpired, FileNotFoundError):
            pass
        return True
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return False


def _find_atspi_tab_list(root):
    """Recursively find the first ROLE_PAGE_TAB_LIST child in the AT-SPI tree."""
    import pyatspi
    try:
        if root.getRole() == pyatspi.ROLE_PAGE_TAB_LIST:
            return root
    except Exception:
        pass
    for i in range(root.childCount):
        try:
            result = _find_atspi_tab_list(root[i])
            if result is not None:
                return result
        except Exception:
            pass
    return None


def _find_nvim_tab_atspi(project_dirname=None, filepath=None):
    """Find nvim's tab index via AT-SPI2 tab name matching.

    Returns 0-based tab index, or -1 if not found / pyatspi unavailable.
    """
    try:
        import pyatspi
    except ImportError:
        return -1

    try:
        desktop = pyatspi.Registry.getDesktop(0)
        xfce_app = next((a for a in desktop if a.name == "xfce4-terminal"), None)
        if xfce_app is None:
            return -1

        for win in xfce_app:
            if win.getRoleName() != "frame":
                continue
            tab_list = _find_atspi_tab_list(win)
            if tab_list is None:
                continue

            for ti in range(tab_list.childCount):
                tab = tab_list[ti]
                if project_dirname:
                    candidates = [
                        tab.name.startswith(project_dirname + " - "),
                        tab.name.startswith(project_dirname + " | "),
                        tab.name == project_dirname,
                    ]
                    match = any(candidates)
                elif filepath:
                    fname = os.path.basename(filepath)
                    match = tab.name == fname
                else:
                    match = False

                if match:
                    return ti

        return -1

    except Exception:
        return -1


def _launch_orphan(filepath, verbose=False):
    os.makedirs(SOCKETS_DIR, exist_ok=True)
    if os.path.exists(ORPHAN_SOCKET):
        os.remove(ORPHAN_SOCKET)
    env = _nvim_env()
    env["NVIM_ORPHAN_GROUP"] = "1"
    cmd = ["nvim", "--listen", ORPHAN_SOCKET, filepath]
    if verbose:
        print(f"Launching orphan with {filepath}", file=sys.stderr)
    if sys.stdin.isatty():
        subprocess.run(cmd, env=env)
    else:
        subprocess.Popen(cmd, env=env, start_new_session=True)


def _launch_project(dirpath, verbose=False):
    env = _nvim_env()
    if verbose:
        print(f"Launching project instance in {dirpath}", file=sys.stderr)
    if sys.stdin.isatty():
        subprocess.run(["nvim"], cwd=dirpath, env=env)
    else:
        subprocess.Popen(["nvim"], cwd=dirpath, env=env, start_new_session=True)


def _parse_path_with_line(filepath):
    """Parse file:line:col notation. Only splits on : after the last path separator."""
    base = filepath
    line = None
    col = None

    sep_pos = filepath.rfind(os.sep)
    colon_after_sep = filepath.find(":", sep_pos + 1) if sep_pos >= 0 else filepath.find(":")

    if colon_after_sep >= 0:
        remainder = filepath[colon_after_sep + 1:]
        base = filepath[:colon_after_sep]
        parts = remainder.split(":", 1)
        try:
            line = int(parts[0])
            if len(parts) > 1:
                col = int(parts[1])
        except ValueError:
            base = filepath
            line = None
            col = None

    return base, line, col


def main():
    if not shutil.which("nvim"):
        sys.exit("nvim-open: nvim not found in PATH. Is Neovim installed?")

    parser = argparse.ArgumentParser(description="Open file in correct Neovim instance")
    parser.add_argument("file", nargs="?", help="File path to open (supports file:line:col)")
    parser.add_argument("--list", action="store_true", help="List registered instances")
    parser.add_argument("--line", type=int, default=None, help="Line number")
    parser.add_argument("--col", type=int, default=None, help="Column number")
    parser.add_argument("--verbose", action="store_true", help="Enable debug logging to stderr")
    args = parser.parse_args()

    if args.list:
        sock = _connect_daemon(args.verbose)
        if not sock:
            print("No daemon running and could not start one.")
            sys.exit(1)
        resp = _send_recv(sock, {"cmd": "list"}, args.verbose)
        sock.close()
        instances = resp.get("instances", [])
        if not instances:
            print("No registered instances.")
        else:
            for inst in instances:
                alive = ""
                try:
                    os.kill(inst["pid"], 0)
                    alive = " [alive]"
                except ProcessLookupError:
                    alive = " [DEAD]"
                except PermissionError:
                    alive = " [alive]"
                label = "(orphan)" if inst.get("orphan") else inst["project_root"]
                print(f"{label} -> {inst['socket']}{alive}")
        sys.exit(0)

    if not args.file:
        sys.exit("nvim-open: file argument required (use --list to view instances)")

    filepath, parsed_line, parsed_col = _parse_path_with_line(args.file)
    line = args.line or parsed_line
    col = args.col or parsed_col

    is_dir = os.path.isdir(args.file) or (os.path.exists(args.file) and os.path.isdir(filepath))

    try:
        filepath = os.path.realpath(filepath)
    except FileNotFoundError:
        if is_dir:
            filepath = os.path.abspath(args.file)
        else:
            dirpart = os.path.realpath(os.path.dirname(args.file))
            filepath = os.path.join(dirpart, os.path.basename(args.file))

    sock = _connect_daemon(args.verbose)
    if not sock:
        sys.exit("nvim-open: could not connect to daemon")

    resp = _send_recv(sock, {
        "cmd": "open",
        "path": filepath,
        "line": line,
        "col": col,
    }, args.verbose)
    sock.close()

    if resp["status"] == "routed":
        target_socket = resp["socket"]
        if not _nvim_remote(target_socket, filepath, line, col, args.verbose):
            if args.verbose:
                print(f"Warning: could not send {filepath} to {target_socket}, file may not exist", file=sys.stderr)
    elif resp["status"] == "no_instance":
        if is_dir or (os.path.exists(filepath) and os.path.isdir(filepath)):
            _launch_project(filepath, args.verbose)
        else:
            _launch_orphan(filepath, args.verbose)


if __name__ == "__main__":
    main()
